# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/renderways
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/renderways
MONGO_URI=mongodb://127.0.0.1:27017/renderways

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Email notifications (nodemailer / SMTP) ----
# Leave SMTP_HOST empty to run in "console mode" (emails printed to terminal, nothing sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Renderways Technology <support@renderways.in>"

# ---- WhatsApp notifications (Meta Cloud API) ----
# Leave WHATSAPP_TOKEN empty to run in "console mode"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Company details (used in emails / seed) ----
COMPANY_NAME=Renderways Technology
COMPANY_EMAIL=support@renderways.in
COMPANY_PHONE=+917358189215
